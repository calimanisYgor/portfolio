---
// Astro file
import { Icon } from "astro-icon/components";
import Clock from "./react/Clock";
import "../../src/styles/global.css";
---

<header
  class="px-5 py-5 flex justify-between fixed top-0 left-0 w-full z-50 xl:bg-transparent"
>
  <!-- Theme Toggle -->
  <div class="h-7 w-7 grid place-items-center">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Alternar para tema escuro"
      aria-pressed="false"
      class="relative h-7 w-7 flex items-center justify-center rounded-md border border-primary bg-background text-primary hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <Icon name="mdi:moon-and-stars" class="theme-icon-dark" />
      <Icon name="mdi:white-balance-sunny" class="theme-icon-light" />
    </button>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;

      function sync() {
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";
        btn.setAttribute("aria-pressed", String(isDark));
        btn.setAttribute(
          "aria-label",
          isDark ? "Alternar para tema claro" : "Alternar para tema escuro"
        );
      }

      sync();

      btn.addEventListener("click", function () {
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";
        var next = isDark ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        sync();
      });
    })();
  </script>

  <!-- Location and Clock -->
  <div class="flex gap-2">
    <div class="flex items-center gap-1 rounded-md border px-2 py-1 text-xs text-muted-foreground bg-background">
      <Icon class="opacity-70" size={14} name="mdi:map-marker-outline" />
      SÃO PAULO
    </div>

    <div class="flex items-center gap-1 rounded-md border px-2 py-1 text-xs text-muted-foreground bg-background">
      <Icon class="opacity-70" size={14} name="mdi:clock-outline" />
      <Clock client:load />
    </div>
  </div>
</header>
