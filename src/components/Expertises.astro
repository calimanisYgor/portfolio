<h3 class="text-xl mb-6">Front-end</h3>
<div class="grid grid-cols-6 gap-3 sm:grid-cols-10 sm:gap-6">
    {
        [
            "react",
            "ts",
            "js",
            "html",
            "css",
            "bootstrap",
        ].map((t) => (
            <div
                class="tech-tooltip pb-2"
                tabindex="0"
                data-tip={t}
                title={t}
            >
                <img src={`https://skillicons.dev/icons?i=${t}`} alt={t} />
            </div>
        ))
    }
</div>

