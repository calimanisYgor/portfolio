---
import { Icon } from "astro-icon/components";
import { withBase } from "@/lib/utils";

const featured = {
  title: "The Tarnished AI",
  image: withBase("projects/tarnished-ai.jpg"),
  summary:
    "Aplicação web que usa inteligência artificial para sugerir builds em jogos Soulslike, com progressão, atributos, armas e estratégias alinhadas ao objetivo do jogador.",
  stack: ["HTML", "CSS", "JavaScript", "Gemini"],
  repo: "https://github.com/calimanisYgor/nlw-agents",
};

const secondary: {
  title: string;
  status?: string;
  visual: "logo" | "image";
  image: string;
  summary: string;
  stack: string[];
  repo?: string;
}[] = [
  {
    title: "Lab.IA",
    status: "Em desenvolvimento",
    visual: "logo",
    image: withBase("projects/lab-ia-logo.png"),
    summary:
      "Aplicação desktop de leitura labial: captura o rosto, extrai landmarks da boca, grava amostras e treina um classificador GRU — tudo localmente, sem chamadas externas.",
    stack: ["Python", "PyTorch", "OpenCV", "Qt", "SQLite"],
  },
  {
    title: "Virtual Keyboard",
    visual: "image",
    image: withBase("projects/virtual-keyboard.png"),
    summary:
      "Teclado virtual controlado por rastreamento de mãos via webcam. Detecta gestos para digitação e controle de aplicativos, como alternativa acessível ao teclado físico.",
    stack: ["Python", "OpenCV", "TensorFlow", "Anaconda"],
    repo: "https://github.com/calimanisYgor/virtualKeyboardPy",
  },
];
---

<section id="projetos" class="scroll-mt-24">
  <div class="reveal">
    <p class="text-xs uppercase tracking-[0.22em] text-muted-foreground">02 — Projetos</p>
    <h2 class="mt-3 font-display text-3xl font-medium tracking-tight md:text-4xl">
      Trabalho selecionado
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
      Uma seleção de projetos pessoais que cruzam produto, visão computacional e inteligência artificial. O destaque vai para a aplicação mais completa; os demais aparecem com o mesmo rigor, em um ritmo visual diferente.
    </p>
  </div>

  <article
    class="project-card reveal mt-10 overflow-hidden rounded-2xl border border-border bg-card/60"
  >
    <div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.9fr)]">
      <div class="relative min-h-56 bg-muted">
        <img
          src={featured.image}
          alt={`Captura de tela do projeto ${featured.title}`}
          class="h-full w-full object-cover object-top lg:absolute lg:inset-0"
        />
      </div>
      <div class="flex flex-col justify-center p-6 md:p-8">
        <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Destaque</p>
        <h3 class="mt-3 font-display text-2xl md:text-3xl">{featured.title}</h3>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:text-base">
          {featured.summary}
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            featured.stack.map((tech) => (
              <li class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
                {tech}
              </li>
            ))
          }
        </ul>
        {featured.repo && (
          <a
            href={featured.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex w-fit items-center gap-2 text-sm text-accent-link hover:underline"
          >
            <Icon name="mdi:github" size={16} />
            Ver código-fonte
          </a>
        )}
      </div>
    </div>
  </article>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {
      secondary.map((project) => (
        <article class="project-card reveal flex flex-col overflow-hidden rounded-2xl border border-border bg-card/60">
          <div
            class:list={[
              "flex min-h-44 items-center justify-center bg-muted",
              project.visual === "logo" && "bg-[#111]",
            ]}
          >
            <img
              src={project.image}
              alt={
                project.visual === "logo"
                  ? `Logotipo do projeto ${project.title}`
                  : `Captura de tela do projeto ${project.title}`
              }
              class:list={[
                project.visual === "logo"
                  ? "max-h-16 w-auto px-8"
                  : "h-44 w-full object-cover object-top",
              ]}
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-display text-xl">{project.title}</h3>
              {project.status && (
                <span class="rounded-full border border-border px-2.5 py-0.5 text-[11px] uppercase tracking-wider text-muted-foreground">
                  {project.status}
                </span>
              )}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              {project.summary}
            </p>
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-fit items-center gap-2 text-sm text-accent-link hover:underline"
              >
                <Icon name="mdi:github" size={16} />
                Ver código-fonte
              </a>
            )}
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <li class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
