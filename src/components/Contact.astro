---
import { Icon } from "astro-icon/components";
import { withBase } from "@/lib/utils";

const channels = [
  {
    href: "mailto:business@calimanis.com",
    label: "E-mail",
    value: "business@calimanis.com",
    icon: "mdi:envelope",
  },
  {
    href: "https://www.linkedin.com/in/ygorcalimanis",
    label: "LinkedIn",
    value: "/ygorcalimanis",
    icon: "mdi:linkedin",
    external: true,
  },
  {
    href: "https://github.com/calimanisYgor",
    label: "GitHub",
    value: "/calimanisYgor",
    icon: "mdi:github",
    external: true,
  },
  {
    href: "tel:+5511999012003",
    label: "Telefone",
    value: "(11) 99901-2003",
    icon: "mdi:phone",
  },
];
---

<section id="contato" class="scroll-mt-24">
  <div class="reveal rounded-2xl border border-border bg-card/50 px-6 py-12 md:px-12 md:py-16">
    <p class="text-xs uppercase tracking-[0.22em] text-muted-foreground">06 — Contato</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-medium tracking-tight md:text-5xl">
      Vamos conversar sobre o próximo problema a resolver.
    </h2>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
      Estou aberto a conversar sobre oportunidades profissionais e projetos. Se fizer sentido alinharmos, o caminho mais direto é o e-mail.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="mailto:business@calimanis.com"
        class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground hover:opacity-90"
      >
        Enviar e-mail
      </a>
      <a
        href={withBase("docs/curriculo-ygor-calimanis.pdf")}
        download
        class="inline-flex min-h-11 items-center rounded-md border border-border px-5 text-sm font-medium hover:border-accent hover:text-accent-link"
      >
        Baixar currículo
      </a>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              target={channel.external ? "_blank" : undefined}
              rel={channel.external ? "noopener noreferrer" : undefined}
              class="flex min-h-11 items-start gap-3 rounded-xl border border-transparent p-3 hover:border-border hover:bg-background/40"
            >
              <Icon class="mt-0.5 text-accent-link" size={20} name={channel.icon} />
              <span>
                <span class="block text-xs uppercase tracking-wider text-muted-foreground">
                  {channel.label}
                </span>
                <span class="mt-1 block text-sm">{channel.value}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
